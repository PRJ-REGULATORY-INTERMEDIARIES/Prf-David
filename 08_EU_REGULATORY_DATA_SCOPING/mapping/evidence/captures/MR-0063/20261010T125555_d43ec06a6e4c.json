{"created": "2026-09-16T20:52:54.854749+00:00", "modified": "2026-09-16T20:52:55.122990+00:00", "id": 22802512, "conceptrecid": "22280073", "doi": "10.5281/zenodo.22802512", "conceptdoi": "10.5281/zenodo.22280073", "doi_url": "https://doi.org/10.5281/zenodo.22802512", "metadata": {"title": "Competition Law Enforcement Dataset (CLED)", "doi": "10.5281/zenodo.22802512", "publication_date": "2026-09-16", "description": "<p>The Competition Law Enforcement Dataset offers lawyers and legal scholars a 100% manually compiled set of observations for over 160 unique variables on the level of cases, infringements, undertakings and individual legal entities within those undertakings. It comprises all digitally published decisions finding an infringement of EU cartel law and abuse of dominance provisions by the European Commission on the basis of Regulation 1/2003.</p>\n<p>The database is designed with reproducibility in mind. It is supplemented by a codebook, which includes references to the nodes in a supplementary NVivo database that direct the user to the specific segments in the enforcement decisions for each variable.</p>\n<p>The NVivo file also contains all CJEU judgments on appeal and links them to the European Commission's original decisions.</p>", "access_right": "open", "creators": [{"name": "De Ceuster, Jeroen", "affiliation": "Ghent University", "orcid": "0000-0002-7642-6150"}], "keywords": ["EU law", "Abuse of dominance", "Cartels", "Antitrust", "Competition authority", "Art. 101 TFEU", "Art. 102 TFEU", "Empirical legal studies"], "related_identifiers": [{"identifier": "10.1093/joclec/nhaf031", "relation": "isSourceOf", "resource_type": "publication", "scheme": "doi"}], "dates": [{"type": "created"}], "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22280073"}}]}}, "title": "Competition Law Enforcement Dataset (CLED)", "links": {"self": "https://zenodo.org/api/records/22802512", "self_html": "https://zenodo.org/records/22802512", "preview_html": "https://zenodo.org/records/22802512?preview=1", "doi": "https://doi.org/10.5281/zenodo.22802512", "self_doi": "https://doi.org/10.5281/zenodo.22802512", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22802512", "reserve_doi": "https://zenodo.org/api/records/22802512/draft/pids/doi", "parent": "https://zenodo.org/api/records/22280073", "parent_html": "https://zenodo.org/records/22280073", "parent_doi": "https://doi.org/10.5281/zenodo.22280073", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22280073", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22802512/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22802512/sequence/default", "files": "https://zenodo.org/api/records/22802512/files", "media_files": "https://zenodo.org/api/records/22802512/media-files", "latest": "https://zenodo.org/api/records/22802512/versions/latest", "latest_html": "https://zenodo.org/records/22802512/latest", "versions": "https://zenodo.org/api/records/22802512/versions", "draft": "https://zenodo.org/api/records/22802512/draft", "access_links": "https://zenodo.org/api/records/22802512/access/links", "access_grants": "https://zenodo.org/api/records/22802512/access/grants", "access_users": "https://zenodo.org/api/records/22802512/access/users", "access_request": "https://zenodo.org/api/records/22802512/access/request", "access": "https://zenodo.org/api/records/22802512/access", "communities": "https://zenodo.org/api/records/22802512/communities", "communities-suggestions": "https://zenodo.org/api/records/22802512/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/22802512/request-deletion", "file_modification": "https://zenodo.org/api/records/22802512/file-modification", "quota_increase": "https://zenodo.org/api/records/22802512/quota-increase", "requests": "https://zenodo.or