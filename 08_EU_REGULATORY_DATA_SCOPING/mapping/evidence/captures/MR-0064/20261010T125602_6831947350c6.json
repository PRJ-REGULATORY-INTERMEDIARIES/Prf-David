{"created": "2026-06-13T11:34:49.562803+00:00", "modified": "2026-06-13T11:34:49.795655+00:00", "id": 19153215, "conceptrecid": "19153214", "doi": "10.5281/zenodo.19153215", "conceptdoi": "10.5281/zenodo.19153214", "doi_url": "https://doi.org/10.5281/zenodo.19153215", "metadata": {"title": "Dataset on Traditional Food Notifications under EU Regulation (2018\u20132026): OpenEFSA-derived and curated data", "doi": "10.5281/zenodo.19153215", "publication_date": "2026-03-21", "description": "<p>This repository contains the dataset underlying the study: <em>&ldquo;</em><strong><span>Traditional Foods from Third Countries in the EU Novel Food Framework: A Regulatory Pathway Analysis</span></strong><em>&rdquo;</em>.</p>\n<p>The dataset was constructed from the OpenEFSA database and includes all Traditional Food notifications submitted under Regulation (EU) 2015/2283 between 2018 and June 2026 (n = 42).</p>\n<p>The repository includes:</p>\n<ul>\n<li>the original dataset extracted from OpenEFSA,</li>\n<li>a curated and harmonised version used for analysis</li>\n</ul>\n<p>Additional documentation describes the data curation process, classification criteria and methodological assumptions.</p>\n<p>This dataset includes author-derived classifications and inferred variables which may be subject to interpretation.</p>", "access_right": "open", "creators": [{"name": "Dall'Asta, Chiara", "affiliation": "University of Parma", "orcid": "0000-0003-0716-8394"}, {"name": "Bonomini, Maria Giulia", "affiliation": "University of Parma", "orcid": "0000-0002-6935-0987"}], "keywords": ["traditional food", "food policy", "regulatory data"], "version": "v1.0 \u2013 dataset accompanying submitted manuscript", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "2022EPRMH9", "internal_id": "0341vw408::2022EPRMH9", "funder": {"name": "Ministero dell'universit\u00e0 e della ricerca"}, "title": "PRIN 2022 \u201cThe future of food, the food of the future. Novelfood, innovation, sustainability and legal issues\u201d", "url": "https://www.prinf4f.org"}, {"code": "PE00000003", "internal_id": "0341vw408::PE00000003", "funder": {"name": "Ministero dell'universit\u00e0 e della ricerca"}, "title": "ON Foods \u2013 Research and innovation network on food and nutrition Su-stainability, Safety and Security \u2013Working ON Foods", "url": "https://onfoods.it"}], "communities": [{"id": "dallasta_lab"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "19153214"}}]}}, "title": "Dataset on Traditional Food Notifications under EU Regulation (2018\u20132026): OpenEFSA-derived and curated data", "links": {"self": "https://zenodo.org/api/records/19153215", "self_html": "https://zenodo.org/records/19153215", "preview_html": "https://zenodo.org/records/19153215?preview=1", "doi": "https://doi.org/10.5281/zenodo.19153215", "self_doi": "https://doi.org/10.5281/zenodo.19153215", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19153215", "reserve_doi": "https://zenodo.org/api/records/19153215/draft/pids/doi", "parent": "https://zenodo.org/api/records/19153214", "parent_html": "https://zenodo.org/records/19153214", "parent_doi": "https://doi.org/10.5281/zenodo.19153214", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19153214", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:19153215/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:19153215/sequence/default", "files": "https://zenodo.org/api/records/19153215/files", "media_files": "https://zenodo.org/api/records/19153215/media-files", "latest": "https://zenodo.org/api/records/19153215/versions/latest", "latest_html": "https://zenodo.org/records/19153215/latest", "versions": "https://zenodo.org/api/records/19153215/versions", "draft": "https://zenodo.org/api/records/19153215/draft", "access_links": "https://zenodo.org/api/records/19153215/access/links", "access_