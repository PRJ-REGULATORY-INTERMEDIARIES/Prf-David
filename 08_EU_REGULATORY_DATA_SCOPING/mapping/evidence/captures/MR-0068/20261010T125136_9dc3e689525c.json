{"status":"OK","data":{"id":4177394,"identifier":"DVN/1BARB6","persistentUrl":"https://doi.org/10.7910/DVN/1BARB6","protocol":"doi","authority":"10.7910","separator":"/","publisher":"Harvard Dataverse","publicationDate":"2021-02-02","storageIdentifier":"s3://10.7910/DVN/1BARB6","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":997,"datasetType":"dataset","locks":[],"latestVersion":{"id":216661,"datasetId":4177394,"datasetPersistentId":"doi:10.7910/DVN/1BARB6","datasetType":"dataset","storageIdentifier":"s3://10.7910/DVN/1BARB6","versionNumber":1,"internalVersionNumber":21,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","deaccessionLink":"","UNF":"UNF:6:u71GovV6bKi3QiaMaA4glQ==","lastUpdateTime":"2021-02-02T13:14:54Z","releaseTime":"2021-02-02T13:14:54Z","createTime":"2020-11-18T20:58:20Z","publicationDate":"2021-02-02","citationDate":"2021-02-02","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":997,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":false,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"National Parliaments in the European Union Dataset (NPdata)"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Winzen, Thomas"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"University of Essex"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0003-4489-8943"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Winzen, Thomas"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"University of Essex"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"Thomas.winzen@essex.ac.uk"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The National Parliaments in the European Union Dataset (NPdata) codes formal rights and mechanisms for parliamentary involvement in EU affairs from 1952 to 2020. It contains information on oversight institutions, which specify parliamentary information and participation rights in relation to the government’s involvement in EU policymaking. NPdata also includes information on parliamentary rights in the European Semester (ES) and decision-making of the European Stability Mechanism (ESM). <br>\n<br>\nThe data is available via Harvard Dataverse. <br>\n<br>\n<b>How to cite:</b><br>\n<br>\nIf you use the data on oversight institutions, please cite Winzen (2012) for data before 2010 and Winzen (2021) for data from 2010-2020. <br>\n<br>\nIf you use the data on parliamentary rights in the ES and ESM, please cite Rittberger and Winzen (2015) or Winzen (2021). <br>\n<br>\n\n<b>Further information and related publications:</b><br>\n<br>\nhttps://thomaswinzen.com/#datasets. <br>\n<br>\nDetailed notes on the coding of individual countries are available from the author.<br>\n<br>\n<b>References:</b> <br>\n<br>\nRittberger, Berthold, and Thomas Winzen. 2015. Parlamentarismus Nach Der Krise: Die Vertiefung Parlamentarischer Asymmetrie in Der Reformierten Wirtschafts- Und Währungsunion. Politische Vierteljahresschrift 56 (3): 430–56. <br>\n<br>\nWinzen, Thomas. 2012. National Parliamentary Control of European Union Affairs: A Cross-National and Longitudinal Comparison. West European Politics 35 (3): 657–72. <br>\n<br>\nWinzen, Thomas. 2021. The Institutional Position of National Parliaments in the European Union: Developments, Explanations, Effects. Journal of European Public Policy. <br>"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2021-02-02"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"European Union"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Parliament"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Winzen, Thomas"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2020-11-18"}]}},"files":[{"label":"NPdata - General overview v1.pdf","restricted":false,"version":1,"datasetVersionId":216661,"dataFile":{"id":4362616,"persistentId":"","filename":"NPdata - General overview v1.pdf","contentType":"application/pdf","friendlyType":"Adobe PDF","filesize":304374,"storageIdentifier":"s3://dvn-cloud:17762daa6d8-01fed6293cb7","rootDataFileId":-1,"md5":"536376e4956ed189f56f63835688333a","checksum":{"type":"MD5","value":"536376e4956ed189f56f63835688333a"},"tabularData":false,"creationDate":"2021-02-02","publicationDate":"2021-02-02","lastUpdateTime":"2021-02-02T13:14:54Z","fileAccessRequest":false}},{"description":"Stata version of the data.","label":"NPdata_version2020_v1-1.tab","restricted":false,"version":3,"datasetVersionId":216661,"dataFile":{"id":4177395,"persistentId":"","filename":"NPdata_version2020_v1-1.tab","contentType":"text/tab-separated-values",