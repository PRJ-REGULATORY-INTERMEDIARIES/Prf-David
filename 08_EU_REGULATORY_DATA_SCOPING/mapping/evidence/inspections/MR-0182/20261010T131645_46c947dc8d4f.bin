{"policy_item_id":755369.0,"policy_item_code":"POL-HC-6201","nutrient_subst_food":"Docosahexaenoic acid (DHA)","nutrient_subst_food_no_html":"Docosahexaenoic acid (DHA)","claim_type":"Art.14(1)(b)","claim_status":"Authorised","claim":"Docosahexaenoic acid (DHA) maternal intake contributes to the normal brain development of the foetus and breastfed infants.","condition_of_use":"Information shall be given to pregnant and lactating women that the beneficial effect is obtained with a daily intake of 200 mg of DHA in addition to the recommended daily intake for omega-3 fatty acids for adults, i.e.: 250 mg DHA and EPA.\r\nThe claim can be used only for food which provides a daily intake of at least 200 mg DHA","health_relation":null,"restrictions_of_use":null,"reasons_of_non_authorisation":null,"efsa_question":"Q-2008-773","efsa_question_url":"http://www.efsa.europa.eu/en/efsajournal/doc/1007.pdf","entry_id":null,"legislation_type":"Regulated by","legislation_reference":"Commission Regulation (EU) No 440/2011","legislation_short":"No 440/2011","legislation_pub_date":null,"legislation_entry_into_force_date":null,"legislation_application_date":null,"legislation_url":"http://eur-lex.europa.eu/LexUriServ/LexUriServ.do?uri=CELEX:32011R0440:EN:NOT","proprietary_data":"No","restriction_expiry_date":null,"fip_url":"https://ec.europa.eu/food/food-feed-portal/screen/health-claims/eu-register/details/POL-HC-6201"}
{"policy_item_id":755405.0,"policy_item_code":"POL-HC-6202","nutrient_subst_food":"Calcium and vitamin D","nutrient_subst_food_no_html":"Calcium and vitamin D","claim_type":"Art.14(1)(a)","claim_status":"Authorised","claim":"<p class=\"tbl-txt\">Calcium and vitamin D help to reduce the loss of bone mineral in post-menopausal women. Low bone mineral density is a risk factor for osteoporotic bone fractures</p>","condition_of_use":"The claim may be used only for food supplements which provide at least 400 mg of calcium and 15 μg of vitamin D per daily portion.\n\nInformation shall be given to the consumer that the claim is specifically intended for women 50 years and older and the beneficial effect is obtained with a daily intake of at least 1 200 mg of calcium and 20 μg of vitamin D from all sources.\nFor food supplements with added calcium and vitamin D the claim may be used only for those targeting women 50 years and older","health_relation":null,"restrictions_of_use":null,"reasons_of_non_authorisation":null,"efsa_question":"Q-2008-721","efsa_question_url":"http://www.efsa.europa.eu/en/efsajournal/doc/1180.pdf","entry_id":null,"legislation_type":"Regulated by","legislation_reference":"10121","legislation_short":"No 1228/2014","legislation_pub_date":null,"legislation_entry_into_force_date":null,"legislation_application_date":null,"legislation_url":"http://eur-lex.europa.eu/legal-content/EN/TXT/?uri=OJ:JOL_2014_331_R_0004","proprietary_data":"No","restriction_expiry_date":null,"fip_url":"https://ec.europa.eu/food/food-feed-portal/screen/health-claims/eu-register/details/POL-HC-6202"}
{"policy_item_id":755405.0,"policy_item_code":"POL-HC-6202","nutrient_subst_food":"Calcium and vitamin D","nutrient_subst_food_no_html":"Calcium and vitamin D","claim_type":"Art.14(1)(a)","claim_status":"Authorised","claim":"<p class=\"tbl-txt\">Calcium and vitamin D help to reduce the loss of bone mineral in post-menopausal women. Low bone mineral density is a risk factor for osteoporotic bone fractures</p>","condition_of_use":"The claim may be used only for food supplements which provide at least 400 mg of calcium and 15 μg of vitamin D per daily portion.\n\nInformation shall be given to the consumer that the claim is specifically intended for women 50 years and older and the beneficial effect is obtained with a daily intake of at least 1 200 mg of calcium and 20 μg of vitamin D from all sources.\nFor food supplements with added calcium and vitamin D the claim may be used only for those targeting women 50 years and older","health_relation":null,"restrictions_of_use":null,"reasons_of_non_authorisation":null,"efsa_question":"Q-2009-00940","efsa_q