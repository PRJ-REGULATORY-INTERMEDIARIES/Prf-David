<!DOCTYPE HTML>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="UTF-8">

    <meta name="HandheldFriendly" content="true">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=2.0, user-scalable=yes, shrink-to-fit=no">

    <!-- Use this on ios devices to disable form-auto-zoom functionality - This is being done automatically in Application.js -->

    <!-- Use Weinre for debugging -->
    <!--<script src="http://localhost:9999/target/target-script-min.js#anonymous"></script>-->

    <title>THETIS-MRV</title>
    <style type="text/css">
        @-webkit-keyframes loader-spin-index {
            0% {-webkit-transform: rotate(0deg);}
            100% {-webkit-transform: rotate(360deg);}
        }
        @-moz-keyframes loader-spin-index {
            0% {-moz-transform: rotate(0deg);}
            100% {-moz-transform: rotate(360deg);}
        }
        @-ms-keyframes loader-spin-index {
            0% { -ms-transform: rotate(0deg); }
            100% { -ms-transform: rotate(360deg); }
        }
        @keyframes loader-spin-index {
            0% {transform: rotate(0deg);}
            100% {transform: rotate(360deg);}
        }
        /*************** Show loading message before extjs lib loading is complete ******************/
        html body::before {
            content: "";
            border: 2px solid #ccc;;
            border-top: 2px solid #016280;
            border-right: 2px solid #016280;
            border-radius: 50%;
            width: 12px;
            height: 12px;    
            -webkit-animation: loader-spin-index 380ms cubic-bezier(.51, .5, .51, .5) infinite;
            -moz-animation: loader-spin-index 380ms cubic-bezier(.51, .5, .51, .5) infinite;
            -ms-animation: loader-spin-index 380ms cubic-bezier(.51, .5, .51, .5) infinite;
            animation: loader-spin-index 380ms cubic-bezier(.51, .5, .51, .5) infinite;
            position: fixed;
            bottom: 50%;
            opacity: 0.6;
            display: block;
            will-change: transform;
            pointer-events: none;
            left: -36px;
            margin-left: 50%;
        }
        html body::after {
            content: "Loading";
            width: 48px;
            text-align: center;
            font-family: Verdana, sans-serif;
            position: fixed;
            bottom: 50%;
            font-size: 13px;
            background-image: none;
            opacity: 0.6;
            color: #013f5e;
            left: -12px;
            margin-left: 50%;
        }
        .x-body::before, .x-body::after {display:none;}
        /*************** Show loading message before extjs lib loading is complete ******************/
    </style>
    
    <!-- Check the custom.css addition in app.json file -->
    <!--
